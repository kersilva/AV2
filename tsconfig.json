{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    // File Layout
    "rootDir": "./src",
    "outDir": "./dist",

    // Environment Settings
    // See also https://aka.ms/tsconfig/module
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    // For nodejs:
    // "lib": ["esnext"],
    // "types": ["node"],
    // and npm install -D @types/node

    "paths": {
      "@/*": ["./src/*"],

      // Src
      "@infra/*": ["./src/infrastructure/*"],

      // Domain
      "@domain/*": ["./src/domain/*"],

      // Modules
      "@autenticacao/*": ["./src/modules/autenticacao/*"],
      "@configuracao/*": ["./src/modules/configuracao/*"],
      "@contrato/*": ["./src/modules/contrato/*"],
      "@equipamento/*": ["./src/modules/equipamento/*"],
      "@journal/*": ["./src/modules/journal/*"],
      "@lote/*": ["./src/modules/lote/*"],
      "@organizacao/*": ["./src/modules/organizacao/*"],
      "@relatorio/*": ["./src/modules/relatorio/*"],
      "@usuario/*": ["./src/modules/usuario/*"]
    },

    // Other Outputs
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    // Stricter Typechecking Options
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    // Style Options
    // "noImplicitReturns": true,
    // "noImplicitOverride": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noFallthroughCasesInSwitch": true,
    // "noPropertyAccessFromIndexSignature": true,

    // Recommended Options
    "strict": true,
    "jsx": "react-jsx",
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "dist-tests", "node_modules", "tests"]
}
