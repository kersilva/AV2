// This is your Prisma schema file
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ====================
// ENUMS
// ====================

enum PapelUsuario {
  ADMINISTRADOR
  OPERADOR_CADASTRO
  GESTOR_ALMOXARIFADO
  AUDITOR
}

enum EstadoFisico {
  NOVO
  BOM_ESTADO
  USADO_LEVE
  USADO_MODERADO
  DANIFICADO_LEVE
  DANIFICADO_GRAVE
  INSERVIVEL
}

enum StatusLote {
  RECEBIDO
  EM_TRIAGEM
  TRIAGEM_CONCLUIDA
  ENCAMINHADO
  FINALIZADO
}

enum StatusRastreamento {
  AGUARDANDO_TRIAGEM
  EM_TRIAGEM
  AGUARDANDO_DESMONTE
  EM_DESMONTE
  PECAS_REAPROVEITADAS
  MATERIAL_RECICLAVEL
  DESCARTE_SEGURO
  BAIXA_DEFINITIVA
}

enum TipoEquipamento {
  COMPUTADOR_MESA
  NOTEBOOK
  MONITOR
  IMPRESSORA
  SERVIDOR
  ROTEADOR
  CABO_ESTRUTURADO
  FONTE_ALIMENTACAO
}

// ====================
// MODELS
// ====================

model Movimentacao {
  id            String   @id
  equipamentoId String
  dataHora      DateTime
  origem        String
  destino       String
  responsavel   String
  observacao    String
  versao            Int      @default(1)

  equipamento Equipamento @relation(fields: [equipamentoId], references: [id])
}

model ClausulaContrato {
  contratoId String
  ordem      Int
  texto      String
  versao     Int      @default(1)

  contrato Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)

  @@id([contratoId, ordem])
}
model Contrato {
  id                  String   @id
  dataAssinatura      DateTime
  dataVencimento      DateTime
  clausulas           ClausulaContrato[]
  valorMensal         Decimal  @db.Decimal(12, 2)
  renovacaoAutomatica Boolean
  versao              Int      @default(1)

  organizacaoId String      @unique
  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id])
}

model Equipamento {
  posicaoNoLote         Int
  historicoMovimentacao Movimentacao[]

  id                  String             @id
  codigoBarrasInterno String             @unique
  tipo                TipoEquipamento
  marca               String
  modelo              String
  anoFabricacao       Int
  estadoFisico        EstadoFisico
  pesoQuilogramas     Decimal @db.Decimal(10, 2)
  loteId              String
  statusRastreamento  StatusRastreamento
  versao            Int      @default(1)

  lote Lote @relation(fields: [loteId], references: [id])
}

model Lote {
  id          String   @id
  dataEntrada DateTime

  organizacaoId       String
  notaFiscal          String
  transportadora      String
  equipamentos        Equipamento[]
  statusProcessamento StatusLote
  observacoes         String
  versao            Int      @default(1)

  organizacao Organizacao @relation(fields: [organizacaoId], references: [id])
}

model Organizacao {
  id                String   @id
  razaoSocial       String
  cnpj              String   @unique
  inscricaoEstadual String
  enderecoCompleto  String
  telefone          String
  email             String
  dataCadastro      DateTime @default(now())
  ativo             Boolean  @default(true)
  versao            Int      @default(1)

  contratoVigente Contrato?
  lotes           Lote[]
}
